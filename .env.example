# UCSD Campus Parking Service — server-side credentials.
# Copy this file to .env and fill in real values. Never commit the real .env.

# Production endpoints. For local testing you may switch to the QA endpoints
# (api-qa.ucsd.edu — same paths) together with QA credentials.
API_URL=https://api.ucsd.edu:8243/campusparkingservice/v1.3/status
TOKEN_URL=https://api.ucsd.edu/oauth2/token
CONSUMER_KEY=replace-with-consumer-key
CONSUMER_SECRET=replace-with-consumer-secret
